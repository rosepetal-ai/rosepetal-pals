# Los parámetros comunes de la comparación del backend del hito 3 (plan,
# «Topología y escenarios comunes»): los mismos para todos los candidatos.
# harness.sh los lee, cada JSON de resultados los copia en `params`, y
# check_results.py rechaza ficheros cuyos parámetros difieran.
#
# Una asignación de shell por línea, sin expansiones; las listas, entre
# comillas dobles. Los comentarios van en líneas propias.

# Plazos y límites del plan.
# Vida de anuncios y contactos en la DHT, en segundos.
TTL_S=120
# Cada cuánto renueva sus anuncios un nodo, en segundos.
REPUBLISH_S=40
# Duración del reposo de S6, en segundos.
IDLE_S=300
# Búsquedas de S1 por cliente y capacidad.
SEARCHES=10
# Candidatos por búsqueda, el límite de la hoja de ruta.
SEARCH_LIMIT=8

# Topología: dos redes internas y un contenedor por nodo.
NET_A=pals-spike-net-a
NET_B=pals-spike-net-b
CPUS=1
MEMORY=512m
# El puerto en que escucha cada nodo (`--listen 0.0.0.0:<puerto>`).
LISTEN_PORT=4433
# Los routers, en las dos redes y en modo servidor de la DHT.
ROUTERS="r1 r2 r3 r4"
OPERATOR_1="r1 r2"
OPERATOR_2="r3 r4"
# Proveedores y clientes, en modo cliente.
PROVIDERS_A="p1 p2"
PROVIDERS_B="p3 p4"
CLIENTS_A="c1 c2"
CLIENTS_B="c3 c4"
# El arranque original, único punto de arranque de todos, y el contacto
# guardado que los clientes tienen además.
BOOTSTRAP=r1
SAVED_CONTACT=r3
# Los nodos que solo arrancan para su escenario, y su red.
S0_NODE=c0
S0_NET=a
S2_NODE=c5
S2_NET=a
S5_NODE=rogue
S5_NET=b
# El proveedor que se para en S3 y el que cambia de red en S7, de B a A.
S3_NODE=p1
S7_NODE=p3
# Los routers que caen en S4.
S4_NODES="r2 r4"

# Direcciones fijas, para que una IP no cambie de nodo cuando el arnés para
# y arranca nodos: las subredes de las dos redes, fuera de los rangos que
# Docker reparte por defecto (172.17-31.0.0/16 y 192.168.0.0/20) para no
# chocar con las redes de otros en un anfitrión compartido, y la IP de cada
# nodo en cada una de sus redes, en el orden A, B. harness.sh comprueba tras
# cada arranque que cada nodo sigue en las suyas.
NET_A_SUBNET=10.213.71.0/24
NET_B_SUBNET=10.213.72.0/24
IP_r1="10.213.71.11 10.213.72.11"
IP_r2="10.213.71.12 10.213.72.12"
IP_r3="10.213.71.13 10.213.72.13"
IP_r4="10.213.71.14 10.213.72.14"
IP_p1=10.213.71.21
IP_p2=10.213.71.22
IP_p3=10.213.72.23
IP_p4=10.213.72.24
IP_c1=10.213.71.31
IP_c2=10.213.71.32
IP_c3=10.213.72.33
IP_c4=10.213.72.34
IP_c0=10.213.71.40
IP_c5=10.213.71.45
IP_rogue=10.213.72.50
# La IP de p3 en la red A después de S7.
S7_IP=10.213.71.23

# Capacidades, del ejemplo del §5.1, y quién anuncia cada una.
CAPABILITY_PREFIX=agentnet:capability:v1:
CAPABILITIES="vision.ocr code.rust.review knowledge.documentation vision.defect-detection"
CAPS_p1="vision.ocr knowledge.documentation"
CAPS_p2="code.rust.review vision.defect-detection"
CAPS_p3="vision.ocr vision.defect-detection"
CAPS_p4="code.rust.review knowledge.documentation"
CAPS_rogue="vision.ocr"

# Cómo espera y sondea el arnés, en segundos.
# Pausa entre sondeos (asentamiento, S3, S5 y S7).
POLL_S=3
# La topología está asentada cuando lo que guardan los routers no cambia en
# este número de sondeos seguidos, o al cabo de SETTLE_MAX_S.
SETTLE_STABLE_POLLS=3
SETTLE_MAX_S=80
# Lo que espera el nodo aislado de S0 antes de buscar, para que un
# descubrimiento local (mDNS, difusión) tenga tiempo de actuar.
S0_GRACE_S=10
# Cada cuánto se muestrean las estadísticas durante el reposo de S6.
IDLE_SAMPLE_S=60
# Lo que puede tardar un nodo en arrancar y en contestar una búsqueda.
HEALTH_TIMEOUT_S=180
SEARCH_TIMEOUT_S=120
