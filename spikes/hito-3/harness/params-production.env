# Los intervalos de producción del plan del hito 3 («Valores que el spec no
# fija y que decide este plan»), para las medidas de S6 de la tarea 7 de la
# fase 2 (condición 1 de H3-D1):
#   harness.sh --params spikes/hito-3/harness/params-production.env --only S6 <id>
# harness.sh lo lee después de params.env, y solo puede cambiar lo que
# params.env ya tiene. Lo que cambia va al `params` del JSON.

# Vida en la DHT de valores y provider records: 3600 s por defecto.
TTL_S=3600
# Republicación: 1200 s por defecto.
REPUBLISH_S=1200
# El reposo de S6 cubre dos vueltas de republicación.
IDLE_S=2400
